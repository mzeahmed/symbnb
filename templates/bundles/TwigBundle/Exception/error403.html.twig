{% extends 'base.html.twig' %}

{% block title %}Access denied{% endblock %}

{% block body %}
    <div class="container py-5 text-center" style="max-width: 640px;">
        <h1 class="display-1 fw-bold text-muted">403</h1>
        <h2 class="fw-bold text-dark mb-3">Access denied!</h2>
        <div class="alert alert-danger mx-auto mb-5" style="max-width: 480px;">
            <p class="mb-0">You don't have permission to access this resource.</p>
        </div>
        <a href="{{ path('app_home') }}" class="btn btn-primary">Back to home</a>
    </div>
{% endblock %}