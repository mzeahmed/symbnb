{% extends 'base.html.twig' %}

{% block title %}Sign In — SymBnb{% endblock %}

{% block body %}
    <section class="d-flex flex-column flex-lg-row overflow-hidden" style="height: 100vh;">

        {# ── Left panel ── #}
        <div class="login-left-panel flex-column justify-content-between position-relative bg-dark overflow-hidden">
            <img src="{{ asset('build/images/login-image.avif') }}" alt="Travel destination"
                 class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover opacity-75">
            <div class="position-absolute top-0 start-0 w-100 h-100"
                 style="background: linear-gradient(to top, rgba(17,24,39,0.8) 0%, rgba(17,24,39,0.2) 50%, transparent 100%);"></div>

            <div class="position-relative p-5 z-1">
                <a href="{{ path('app_home') }}" class="d-flex align-items-center gap-2 text-white text-decoration-none">
                    <div class="bg-coral rounded-3 d-flex align-items-center justify-content-center shadow"
                         style="width: 2.5rem; height: 2.5rem;">
                        <i class="fa-solid fa-house-chimney text-white"></i>
                    </div>
                    <span class="fs-4 fw-bold">SymBnb</span>
                </a>
            </div>

            <div class="position-relative p-5 pb-5 z-1" style="max-width: 480px;">
                <div class="d-flex gap-1 text-coral mb-3">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
                <h2 class="fs-3 fw-semibold text-white lh-base mb-4">
                    "The easiest way to find and book unique places to stay around the world."
                </h2>
                {% if user is defined and user %}
                    <div class="d-flex align-items-center gap-3">
                        <img src="{{ user.avatar }}" alt="{{ user.fullName }}"
                             class="rounded-circle border border-2 border-white border-opacity-25 object-fit-cover"
                             style="width: 2.5rem; height: 2.5rem;">
                        <div>
                            <p class="text-white fw-medium small mb-0">{{ user.fullName }}</p>
                            <p class="text-white-50 small mb-0">Travel Blogger</p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# ── Right panel ── #}
        <div class="login-right-panel d-flex flex-column justify-content-center align-items-center p-4 p-sm-5 bg-white overflow-auto">
            <div class="d-lg-none w-100 mb-4" style="max-width: 440px;">
                <a href="{{ path('app_home') }}" class="d-flex align-items-center gap-2 text-dark text-decoration-none">
                    <div class="bg-coral rounded-2 d-flex align-items-center justify-content-center shadow-sm"
                         style="width: 2rem; height: 2rem;">
                        <i class="fa-solid fa-house-chimney text-white small"></i>
                    </div>
                    <span class="fs-5 fw-bold">SymBnb</span>
                </a>
            </div>

            <div class="card border shadow-lg p-4 p-sm-5 w-100" style="max-width: 440px; border-radius: 1.5rem;">
                {% if error %}
                    <div class="alert alert-danger small mb-4">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info small mb-4">
                        You are logged in as {{ app.user.userIdentifier }},
                        <a href="{{ logout_path() }}" class="fw-semibold">Logout</a>
                    </div>
                {% endif %}

                <div class="mb-4">
                    <h1 class="fs-3 fw-bold text-dark mb-1">Welcome back</h1>
                    <p class="text-muted small mb-0">Sign in to continue your travel journey</p>
                </div>

                <form method="post">
                    <div class="mb-3">
                        <label for="username" class="form-label fw-medium small">Email address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fa-regular fa-envelope text-muted"></i>
                            </span>
                            <input type="email" value="{{ last_username }}" name="_username" id="username"
                                   autocomplete="email" required autofocus
                                   class="form-control border-start-0 ps-0"
                                   placeholder="name@example.com">
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="password" class="form-label fw-medium small mb-0">Password</label>
                            <a href="#" class="text-coral small text-decoration-none">Forgot password?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fa-solid fa-lock text-muted"></i>
                            </span>
                            <input type="password" name="_password" id="password"
                                   autocomplete="current-password" required
                                   class="form-control border-start-0 ps-0"
                                   placeholder="••••••••">
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-coral w-100 py-3 fw-semibold">Sign in</button>
                </form>

                <p class="mt-4 text-center small text-muted mb-0">
                    Don't have an account?
                    <a href="{{ path('app_register') }}" class="text-coral fw-semibold text-decoration-none">Sign up</a>
                </p>
            </div>
        </div>
    </section>
{% endblock %}