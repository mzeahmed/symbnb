{% extends 'base.html.twig' %}

{% block title %}SymBnb - Create your account{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('security') }}
{% endblock %}

{% block body %}
    <div class="bg-gray-50 min-h-screen flex flex-col m-0 p-0">
        <main class="flex-grow flex flex-col md:flex-row min-h-screen">
            <section class="hidden md:flex md:w-5/12 lg:w-1/2 relative bg-gray-900 overflow-hidden items-center justify-center">
                <div class="absolute inset-0 z-0">
                    <img src="{{ asset('build/images/register-image.avif') }}" alt="Beautiful apartment interior" class="w-full h-full object-cover opacity-60">
                </div>
                <div class="relative z-10 px-12 lg:px-20 text-white max-w-2xl">
                    <h1 class="text-5xl lg:text-6xl font-bold mb-6 leading-tight tracking-tight">
                        Find your next<br>perfect stay.
                    </h1>
                    <p class="text-lg lg:text-xl text-gray-200 mb-8 font-light leading-relaxed">
                        Join millions of hosts and guests experiencing the world together. Discover unique homes and experiences around the
                        globe.
                    </p>

                    <div class="flex items-center gap-4 mt-12">
                        <div class="flex -space-x-4">
                            {% for item in bestUsers %}
                                {% set user = item.user %}

                                <img
                                        class="w-10 h-10 rounded-full border-2 border-white object-cover"
                                        src="{{ user.avatar }}"
                                        alt="{{ user.firstName }} {{ user.lastName }}"
                                >
                            {% endfor %}

                            <div class="w-10 h-10 rounded-full border-2 border-white bg-gray-800 flex items-center justify-center text-xs font-bold">
                                +2M
                            </div>
                        </div>
                        <div class="text-sm font-medium text-gray-300">Hosts worldwide</div>
                    </div>
                </div>
            </section>

            <section class="w-full md:w-7/12 lg:w-1/2 flex items-center justify-center p-6 lg:p-12 bg-white">
                <div class="w-full max-w-md">
                    <div class="mb-8">
                        <h2 class="text-3xl font-bold text-gray-900 mb-2">Create your account</h2>
                        <p class="text-gray-500">Join SymBnb and start planning your next stay.</p>
                    </div>

                    {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

                    {% if not form.vars.valid %}
                        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 space-y-1">
                            {{ form_errors(form) }}

                            {% for field in form %}
                                {{ form_errors(field) }}
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label for="{{ form.firstName.vars.id }}" class="block text-sm font-medium text-gray-700">First Name</label>
                            {{ form_widget(form.firstName, {'attr': {'class': 'w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-900'}}) }}
                            {{ form_errors(form.firstName) }}
                        </div>
                        <div class="space-y-1.5">
                            <label for="{{ form.lastName.vars.id }}" class="block text-sm font-medium text-gray-700">Last Name</label>
                            {{ form_widget(form.lastName, {'attr': {'class': 'w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-900'}}) }}
                            {{ form_errors(form.lastName) }}
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label for="{{ form.email.vars.id }}" class="block text-sm font-medium text-gray-700">Email Address</label>
                        {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-900'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="space-y-1.5">
                        <label for="{{ form.phone.vars.id }}" class="block text-sm font-medium text-gray-700">Phone Number
                            <span class="text-gray-400 font-normal">(Optional)</span></label>
                        {{ form_widget(form.phone, {'attr': {'class': 'w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-900', 'placeholder': '+1 (555) 000-0000'}}) }}
                        {{ form_errors(form.phone) }}
                    </div>

                    <div class="space-y-1.5">
                        <label for="{{ form.password.vars.id }}" class="block text-sm font-medium text-gray-700">Password</label>
                        {{ form_widget(form.password, {'attr': {'class': 'w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-900'}}) }}
                        {{ form_errors(form.password) }}
                        <p class="text-xs text-gray-500 mt-1">Use 8 or more characters with a mix of letters, numbers and symbols.</p>
                    </div>

                    <div class="space-y-1.5">
                        <label for="{{ form.passwordConfirm.vars.id }}" class="block text-sm font-medium text-gray-700">Confirm
                            Password</label>
                        {{ form_widget(form.passwordConfirm, {'attr': {'class': 'w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-900'}}) }}
                        {{ form_errors(form.passwordConfirm) }}
                    </div>

                    <button
                            type="submit"
                            class="w-full bg-coral hover:bg-coral-dark text-white font-semibold py-3.5 px-4 rounded-xl transition-colors duration-200 shadow mt-6 cursor-pointer"
                            id="register-button"
                    >
                        Create Account
                    </button>

                    {{ form_end(form) }}

                    <div class="flex items-center my-8">
                        <div class="flex-grow h-px bg-gray-200"></div>
                        <span class="px-4 text-sm text-gray-500 font-medium">or</span>
                        <div class="flex-grow h-px bg-gray-200"></div>
                    </div>

                    <div class="space-y-3">
                        <button type="button" class="w-full flex items-center justify-center gap-3 bg-white border border-gray-200 text-gray-700 font-medium py-3 px-4 rounded-xl hover:bg-gray-50 transition-colors duration-200">
                            <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google">
                            Continue with Google
                        </button>
                    </div>

                    <p class="text-center mt-8 text-gray-600 text-sm">
                        Already have an account?
                        <a href="{{ path('account_login') }}" class="text-coral font-semibold hover:underline">Sign in</a>
                    </p>
                </div>
            </section>
        </main>
    </div>
{% endblock %}
