{% extends 'base.html.twig' %}

{% block title %}SymBnb - Create your account{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('security') }}
{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-md-row min-vh-100 bg-light">

        {# ── Left panel ── #}
        <section class="register-left-panel flex-column align-items-center justify-content-center position-relative bg-dark overflow-hidden"
                 style="width: 42%; min-width: 340px;">
            <div class="position-absolute top-0 start-0 w-100 h-100">
                <img src="{{ asset('build/images/register-image.avif') }}" alt="Beautiful apartment interior"
                     class="w-100 h-100 object-fit-cover opacity-75">
            </div>
            <div class="position-relative text-white px-5 py-5" style="max-width: 520px; z-index: 1;">
                <h1 class="display-5 fw-bold mb-4 lh-base">
                    Find your next<br>perfect stay.
                </h1>
                <p class="lead text-white-75 mb-5 fw-light lh-relaxed">
                    Join millions of hosts and guests experiencing the world together.
                    Discover unique homes and experiences around the globe.
                </p>

                <div class="d-flex align-items-center gap-3 mt-4">
                    <div class="d-flex" style="margin-left: -0.5rem;">
                        {% for item in bestUsers %}
                            {% set user = item.user %}
                            <img class="rounded-circle border border-2 border-white object-fit-cover"
                                 style="width: 2.5rem; height: 2.5rem; margin-left: -0.5rem;"
                                 src="{{ user.avatar }}"
                                 alt="{{ user.firstName }} {{ user.lastName }}">
                        {% endfor %}
                        <div class="rounded-circle border border-2 border-white bg-dark d-flex align-items-center justify-content-center"
                             style="width: 2.5rem; height: 2.5rem; margin-left: -0.5rem; font-size: 0.65rem; font-weight: 700;">
                            +2M
                        </div>
                    </div>
                    <span class="small fw-medium text-white-50">Hosts worldwide</span>
                </div>
            </div>
        </section>

        {# ── Right panel ── #}
        <section class="register-right-panel flex-fill d-flex align-items-center justify-content-center p-4 p-lg-5 bg-white">
            <div class="w-100" style="max-width: 480px;">
                <div class="mb-5">
                    <h2 class="fs-3 fw-bold text-dark mb-1">Create your account</h2>
                    <p class="text-muted mb-0">Join SymBnb and start planning your next stay.</p>
                </div>

                {{ form_start(form) }}

                {% if not form.vars.valid %}
                    <div class="alert alert-danger small mb-4">
                        {{ form_errors(form) }}
                        {% for field in form %}
                            {{ form_errors(field) }}
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label for="{{ form.firstName.vars.id }}" class="form-label fw-medium small">First Name</label>
                        {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-12 col-sm-6">
                        <label for="{{ form.lastName.vars.id }}" class="form-label fw-medium small">Last Name</label>
                        {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>

                <div class="mb-3">
                    <label for="{{ form.email.vars.id }}" class="form-label fw-medium small">Email Address</label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="mb-3">
                    <label for="{{ form.phone.vars.id }}" class="form-label fw-medium small">
                        Phone Number <span class="text-muted fw-normal">(Optional)</span>
                    </label>
                    {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': '+1 (555) 000-0000'}}) }}
                </div>

                <div class="mb-3">
                    <label for="{{ form.password.vars.id }}" class="form-label fw-medium small">Password</label>
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-text">Use 8+ characters with letters, numbers and symbols.</div>
                </div>

                <div class="mb-4">
                    <label for="{{ form.passwordConfirm.vars.id }}" class="form-label fw-medium small">Confirm Password</label>
                    {{ form_widget(form.passwordConfirm, {'attr': {'class': 'form-control'}}) }}
                </div>

                <button type="submit" class="btn btn-coral w-100 py-3 fw-semibold mb-4" id="register-button">
                    Create Account
                </button>

                {{ form_end(form) }}

                <div class="d-flex align-items-center my-4">
                    <hr class="flex-fill">
                    <span class="px-3 text-muted small fw-medium">or</span>
                    <hr class="flex-fill">
                </div>

                <button type="button" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-3 py-3 mb-4">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="d-none" style="width: 1.25rem; height: 1.25rem;" alt="Google">
                    Continue with Google
                </button>

                <p class="text-center text-muted small mb-0">
                    Already have an account?
                    <a href="{{ path('app_login') }}" class="text-coral fw-semibold text-decoration-none">Sign in</a>
                </p>
            </div>
        </section>
    </div>
{% endblock %}