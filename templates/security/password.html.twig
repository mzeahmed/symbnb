{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 560px;">
        <h1 class="fw-bold text-dark mb-5">Change Password</h1>

        <div class="card border shadow-soft">
            <div class="card-body p-4">
                {{ form_start(form) }}
                {{ form_widget(form) }}

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-coral d-inline-flex align-items-center gap-2">
                        <i class="fas fa-check"></i>
                        Update Password
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}