{% block _ad_images_widget %}
    <p class="text-muted mb-3">Add your own images here!</p>

    {{ form_widget(form) }}

    <input type="hidden" id="widgets-counter" value="0">

    <div class="mb-3">
        <button type="button" id="add-image" class="btn btn-coral btn-sm d-inline-flex align-items-center gap-2">
            <i class="fas fa-plus"></i>
            Add an image
        </button>
    </div>
{% endblock %}

{% block _ad_images_entry_row %}
    {{ form_widget(form) }}
{% endblock %}

{% block _ad_images_entry_widget %}
    <div class="mb-3" id="block_{{ id }}">
        <div class="d-flex gap-3 align-items-center">
            <div class="flex-fill">
                <div class="row g-3">
                    <div class="col">{{ form_widget(form.url) }}</div>
                    <div class="col">{{ form_widget(form.caption) }}</div>
                </div>
            </div>
            <div class="flex-shrink-0">
                <button type="button" data-action="delete" data-target="#block_{{ id }}"
                        class="btn btn-danger btn-sm">X</button>
            </div>
        </div>
    </div>
{% endblock %}