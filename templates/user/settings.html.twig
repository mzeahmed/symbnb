{% extends 'base.html.twig' %}

{% block title %}Profile Settings{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 960px;">
        <h1 class="fw-bold text-dark mb-5">Profile Settings</h1>

        {{ form_start(form) }}

        <div class="row g-4">
            <div class="col-12 col-md-6">
                <div class="card border shadow-soft h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold text-dark mb-1">General Information</h5>
                        <hr class="mb-4">
                        {{ form_row(form.firstName) }}
                        {{ form_row(form.lastName) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.phone) }}
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card border shadow-soft h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold text-dark mb-1">Details</h5>
                        <hr class="mb-4">
                        {{ form_row(form.avatar) }}
                        {{ form_row(form.bio) }}
                        <hr class="my-4">
                        <p class="text-muted small mb-4">Once you're done with your changes, save them below.</p>
                        <button type="submit" class="btn btn-coral d-inline-flex align-items-center gap-2">
                            <i class="fas fa-check"></i>
                            Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}