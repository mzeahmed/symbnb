{% extends 'base.html.twig' %}

{% block title %}Become a Host{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container text-center" style="max-width: 640px;">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
                 style="width: 5rem; height: 5rem; background-color: rgba(255,90,95,0.1);">
                <i class="fa-solid fa-house-chimney fs-3 text-coral"></i>
            </div>
            <h1 class="fw-bold text-dark mb-3">Become a Host</h1>
            <p class="lead text-muted mb-5">
                Share your space and earn extra income. This feature is coming soon — we'll notify you when it's ready!
            </p>
            <a href="{{ path('app_home') }}" class="btn btn-coral btn-lg rounded-pill px-5 fw-semibold shadow-soft">
                Back to Home
            </a>
        </div>
    </section>
{% endblock %}