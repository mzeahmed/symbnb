{% extends 'base.html.twig' %}

{% block title %}My Bookings{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 960px;">
        <h1 class="fw-bold text-dark mb-3">My Bookings</h1>

        <div class="alert alert-info mb-5">
            Find all your past and upcoming bookings below.
        </div>

        {% for booking in app.user.bookings %}
            {% set ad = booking.ad %}

            <div class="row g-4 mb-5 pb-5 border-bottom">
                <div class="col-12 col-sm-4">
                    <img src="{{ ad.coverImage }}" alt="Photo of {{ ad.title }}"
                         class="w-100 object-fit-cover rounded-3 h-48">

                    <div class="mt-3 small">
                        {% set comment = ad.commentFromAuthor(app.user) %}
                        {% if comment is not null %}
                            <strong class="text-dark">Your rating: </strong>
                            {% include 'partials/_rating.html.twig' with {'rating': comment.rating} %}
                        {% else %}
                            <span class="text-muted">You haven't rated this stay yet.</span>
                            <a href="{{ path('booking_show', {'id': booking.id}) }}#comment"
                               class="text-coral text-decoration-none ms-1">Leave a review</a>
                        {% endif %}
                    </div>
                </div>

                <div class="col-12 col-sm-8">
                    <h5 class="fw-semibold text-dark mb-2">{{ ad.title }}</h5>
                    <p class="text-muted mb-4">
                        Booking <strong class="text-dark">#{{ booking.id }}</strong><br>
                        {{ booking.startDate|date('d/m/Y') }} — {{ booking.endDate|date('d/m/Y') }}
                        ({{ booking.amount|number_format(2, ',', ' ') }} &euro;)
                    </p>
                    <a href="{{ path('booking_show', {'id': booking.id}) }}"
                       class="btn btn-primary btn-sm">More information</a>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}