<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

        <meta charset="UTF-8">
        <title>{% block title %}Symbnb - Find Your Perfect Stay{% endblock %}</title>

        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, nofollow">

        {% block seo %}{% endblock %}

        <script> window.FontAwesomeConfig = { autoReplaceSvg: 'nest' };</script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    {% set currentRoute = app.request.attributes.get('_route') %}
    {% set isLoginPage = currentRoute == 'app_login' %}
    {% set isRegisterPage = currentRoute in ['account_register', 'app_register'] %}
    {% set pageBody %}{% block body %}{% endblock %}{% endset %}

    <body class="{% block body_class %}{% endblock %} {{ (isLoginPage or isRegisterPage) ? 'overflow-hidden' : '' }}">

        {# ── Flash messages ── #}
        <div class="position-fixed top-0 start-50 translate-middle-x mt-3 px-3" style="z-index: 1090; width: 100%; max-width: 600px; pointer-events: none;">
            {% for label, messages in app.flashes %}
                {% set alertClass = label == 'success' ? 'alert-success' : (label == 'error' ? 'alert-danger' : 'alert-info') %}
                <div class="alert {{ alertClass }} shadow pointer-events-auto mb-2" role="alert">
                    {% for message in messages %}
                        <p class="mb-0">{{ message | raw }}</p>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <div id="page_loader" class="page-loader">
            <div class="loader"></div>
        </div>

        {% if not isLoginPage and not isRegisterPage %}
            {% include 'partials/_header.html.twig' %}
        {% endif %}

        {% if isLoginPage or isRegisterPage %}
            {{ pageBody }}
        {% else %}
            <main id="main-content" class="{% block main_class %}{% endblock %}">
                {{ pageBody }}
            </main>
        {% endif %}

        {% block show_footer %}{% endblock %}
        {% if not isLoginPage and not isRegisterPage and block('show_footer') != 'false' %}
            {% include 'partials/_footer.html.twig' %}
        {% endif %}
    </body>
</html>