{% extends 'base.html.twig' %}

{% block body %}
    <!-- Hero Section -->
    <section id="hero-section" class="bg-gradient-to-br from-gray-50 to-gray-100 py-20 md:py-32">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-4">Find your perfect stay</h1>
                <p class="text-lg sm:text-xl text-gray-600">Discover unique places to stay around the world</p>
            </div>

            <!-- Search Bar -->
            <div id="search-bar" class="max-w-5xl mx-auto bg-white rounded-full shadow-xl p-2">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                    <div class="flex items-center px-6 py-4 border-b md:border-b-0 md:border-r border-gray-200 cursor-pointer hover:bg-gray-50 rounded-full md:rounded-l-full md:rounded-r-none transition">
                        <div class="flex-1">
                            <label class="block text-xs font-semibold text-gray-900 mb-1">Location</label>
                            <input type="text" placeholder="Where are you going?" class="w-full text-sm text-gray-600 outline-none bg-transparent">
                        </div>
                    </div>

                    <div class="flex items-center px-6 py-4 border-b md:border-b-0 md:border-r border-gray-200 cursor-pointer hover:bg-gray-50 transition">
                        <div class="flex-1">
                            <label class="block text-xs font-semibold text-gray-900 mb-1">Check in</label>
                            <input type="text" placeholder="Add dates" class="w-full text-sm text-gray-600 outline-none bg-transparent">
                        </div>
                    </div>

                    <div class="flex items-center px-6 py-4 border-b md:border-b-0 md:border-r border-gray-200 cursor-pointer hover:bg-gray-50 transition">
                        <div class="flex-1">
                            <label class="block text-xs font-semibold text-gray-900 mb-1">Check out</label>
                            <input type="text" placeholder="Add dates" class="w-full text-sm text-gray-600 outline-none bg-transparent">
                        </div>
                    </div>

                    <div class="flex items-center px-6 py-4 cursor-pointer hover:bg-gray-50 rounded-full md:rounded-l-none md:rounded-r-full transition">
                        <div class="flex-1">
                            <label class="block text-xs font-semibold text-gray-900 mb-1">Guests</label>
                            <input type="text" placeholder="Add guests" class="w-full text-sm text-gray-600 outline-none bg-transparent">
                        </div>
                        <a href="{{ path('ads_index') }}" class="ml-4 bg-coral hover:bg-coral-dark text-white rounded-full p-4 transition">
                            <i class="fa-solid fa-search"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Properties Section -->
    <section id="featured-properties" class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-2">Featured stays</h2>
                <p class="text-gray-600">Hand-picked properties for your next adventure</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {% for ad in ads %}
                    <div id="property-card-{{ loop.index }}" class="group cursor-pointer">
                        <a href="{{ path('ads_show', {'slug': ad.slug}) }}" class="block">
                            <div class="relative overflow-hidden rounded-2xl mb-3 h-64">
                                <img class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
                                     src="{{ ad.coverImage }}"
                                     alt="{{ ad.title }}" />
                                <button class="absolute top-3 right-3 p-2 hover:scale-110 transition">
                                    <i class="fa-regular fa-heart text-white text-xl drop-shadow-lg"></i>
                                </button>
                            </div>
                            <div class="flex justify-between items-start mb-1">
                                <h3 class="font-semibold text-gray-900">{{ ad.title }}</h3>
                                <div class="flex items-center space-x-1">
                                    <i class="fa-solid fa-star text-xs text-gray-900"></i>
                                    <span class="text-sm font-medium">{{ ad.rating ?? '4.9' }}</span>
                                </div>
                            </div>
                            <p class="text-gray-600 text-sm mb-1">{{ ad.city }}, {{ ad.country }}</p>
                            <p class="text-gray-900">
                                <span class="font-semibold">${{ ad.price }}</span>
                                <span class="text-gray-600 text-sm">/ night</span>
                            </p>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section id="cta-section" class="py-20 bg-gradient-to-r from-coral to-coral-dark">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Ready to host?</h2>
            <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
                Share your space and earn extra income by becoming a host on Symbnb
            </p>
            <a href="{{ path('ads_create') }}" class="inline-block bg-white text-coral hover:bg-gray-100 font-semibold px-8 py-4 rounded-full transition shadow-lg hover:shadow-xl">
                Get Started
            </a>
        </div>
    </section>

    <!-- Trust Section -->
    <section id="trust-section" class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div id="trust-card-1" class="text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-coral/10 rounded-full mb-4">
                        <i class="fa-solid fa-shield-halved text-2xl text-coral"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Secure Booking</h3>
                    <p class="text-gray-600">Your payment information is always protected with industry-leading security</p>
                </div>

                <div id="trust-card-2" class="text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-coral/10 rounded-full mb-4">
                        <i class="fa-solid fa-headset text-2xl text-coral"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">24/7 Support</h3>
                    <p class="text-gray-600">Our customer service team is here to help you anytime, anywhere</p>
                </div>

                <div id="trust-card-3" class="text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-coral/10 rounded-full mb-4">
                        <i class="fa-solid fa-star text-2xl text-coral"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Verified Reviews</h3>
                    <p class="text-gray-600">All reviews come from real guests who have stayed at the property</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Top Users Section -->
    {% if users %}
        <section id="top-users" class="py-16 bg-white border-t border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="mb-12">
                    <h2 class="text-3xl font-bold text-gray-900 mb-2">Featured hosts</h2>
                    <p class="text-gray-600">Discover our most trusted and highly-rated hosts</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {% for item in users %}
                        {% set user = item.user %}
                        <a href="{{ path('user_show', {'slug': user.slug}) }}" class="group">
                            <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition">
                                <div class="h-40 bg-gradient-to-br from-coral to-coral-dark"></div>
                                <div class="px-6 py-4 -mt-20 relative">
                                    <img src="{{ user.avatar }}" alt="{{ user.fullName }}" class="w-24 h-24 rounded-full border-4 border-white object-cover">
                                    <h3 class="mt-4 text-lg font-semibold text-gray-900">{{ user.fullName }}</h3>
                                    <p class="text-gray-600 text-sm mt-2 line-clamp-2">{{ user.bio ?? 'Experienced host' }}</p>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}