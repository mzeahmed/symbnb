{% extends 'base.html.twig' %}

{% block body %}
    {# ── Hero Section ── #}
    <section id="hero-section" class="py-5 py-md-6" style="background: linear-gradient(135deg, #F9FAFB 0%, #F3F4F6 100%);">
        <div class="container-xl px-4">
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-dark mb-3">Find your perfect stay</h1>
                <p class="lead text-muted">Discover unique places to stay around the world</p>
            </div>

            <div id="search-bar" class="bg-white rounded-pill shadow-lg p-2 mx-auto" style="max-width: 900px;">
                <div class="row g-0">
                    <div class="col-12 col-md-3 border-bottom border-md-bottom-0 border-md-end px-4 py-3">
                        <label class="d-block text-dark fw-semibold small mb-1">Location</label>
                        <input type="text" placeholder="Where are you going?" class="form-control border-0 p-0 bg-transparent small text-muted shadow-none">
                    </div>
                    <div class="col-12 col-md-3 border-bottom border-md-bottom-0 border-md-end px-4 py-3">
                        <label class="d-block text-dark fw-semibold small mb-1">Check in</label>
                        <input type="text" placeholder="Add dates" class="form-control border-0 p-0 bg-transparent small text-muted shadow-none">
                    </div>
                    <div class="col-12 col-md-3 border-bottom border-md-bottom-0 border-md-end px-4 py-3">
                        <label class="d-block text-dark fw-semibold small mb-1">Check out</label>
                        <input type="text" placeholder="Add dates" class="form-control border-0 p-0 bg-transparent small text-muted shadow-none">
                    </div>
                    <div class="col-12 col-md-3 px-4 py-3 d-flex align-items-center justify-content-between">
                        <div class="flex-fill">
                            <label class="d-block text-dark fw-semibold small mb-1">Guests</label>
                            <input type="text" placeholder="Add guests" class="form-control border-0 p-0 bg-transparent small text-muted shadow-none">
                        </div>
                        <a href="{{ path('ads_index') }}" class="btn btn-coral rounded-circle p-3 ms-3 flex-shrink-0">
                            <i class="fa-solid fa-search"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── Featured Properties ── #}
    <section id="featured-properties" class="py-5 bg-white">
        <div class="container-xl px-4">
            <div class="mb-5">
                <h2 class="fw-bold text-dark mb-1">Featured stays</h2>
                <p class="text-muted mb-0">Hand-picked properties for your next adventure</p>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                {% for ad in ads %}
                    <div id="property-card-{{ loop.index }}" class="col">
                        <a href="{{ path('ads_show', {'slug': ad.slug}) }}" class="text-decoration-none">
                            <div class="card border-0 h-100 card-hover">
                                <div class="position-relative overflow-hidden rounded-3" style="height: 16rem;">
                                    <img class="w-100 h-100 object-fit-cover transition-all"
                                         src="{{ ad.coverImage }}"
                                         alt="{{ ad.title }}">
                                    <button class="btn position-absolute top-0 end-0 m-2 p-2 bg-transparent border-0">
                                        <i class="fa-regular fa-heart text-white fs-5" style="filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));"></i>
                                    </button>
                                </div>
                                <div class="card-body px-1 pt-3 pb-0">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-semibold text-dark mb-0 text-truncate pe-2">{{ ad.title }}</h6>
                                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                            <i class="fa-solid fa-star text-dark" style="font-size: 0.7rem;"></i>
                                            <small class="fw-medium">{{ ad.rating ?? '4.9' }}</small>
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-1">{{ ad.city }}, {{ ad.country }}</p>
                                    <p class="text-dark mb-0">
                                        <span class="fw-semibold">${{ ad.price }}</span>
                                        <span class="text-muted small"> / night</span>
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ── CTA Section ── #}
    <section id="cta-section" class="py-5" style="background: linear-gradient(90deg, #FF5A5F, #E0484D);">
        <div class="container-xl px-4 text-center">
            <h2 class="display-5 fw-bold text-white mb-3">Ready to host?</h2>
            <p class="lead text-white mb-4 mx-auto" style="max-width: 540px; opacity: 0.9;">
                Share your space and earn extra income by becoming a host on Symbnb
            </p>
            <a href="{{ path('ads_create') }}" class="btn btn-light btn-lg rounded-pill px-5 fw-semibold shadow text-coral">
                Get Started
            </a>
        </div>
    </section>

    {# ── Trust Section ── #}
    <section id="trust-section" class="py-5 bg-light">
        <div class="container-xl px-4">
            <div class="row row-cols-1 row-cols-md-3 g-5">
                <div id="trust-card-1" class="col text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 4rem; height: 4rem; background-color: rgba(255,90,95,0.1);">
                        <i class="fa-solid fa-shield-halved fs-4 text-coral"></i>
                    </div>
                    <h5 class="fw-semibold text-dark mb-2">Secure Booking</h5>
                    <p class="text-muted mb-0">Your payment information is always protected with industry-leading security</p>
                </div>

                <div id="trust-card-2" class="col text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 4rem; height: 4rem; background-color: rgba(255,90,95,0.1);">
                        <i class="fa-solid fa-headset fs-4 text-coral"></i>
                    </div>
                    <h5 class="fw-semibold text-dark mb-2">24/7 Support</h5>
                    <p class="text-muted mb-0">Our customer service team is here to help you anytime, anywhere</p>
                </div>

                <div id="trust-card-3" class="col text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 4rem; height: 4rem; background-color: rgba(255,90,95,0.1);">
                        <i class="fa-solid fa-star fs-4 text-coral"></i>
                    </div>
                    <h5 class="fw-semibold text-dark mb-2">Verified Reviews</h5>
                    <p class="text-muted mb-0">All reviews come from real guests who have stayed at the property</p>
                </div>
            </div>
        </div>
    </section>

    {# ── Top Users ── #}
    {% if users %}
        <section id="top-users" class="py-5 bg-white border-top">
            <div class="container-xl px-4">
                <div class="mb-5">
                    <h2 class="fw-bold text-dark mb-1">Featured hosts</h2>
                    <p class="text-muted mb-0">Discover our most trusted and highly-rated hosts</p>
                </div>

                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                    {% for item in users %}
                        {% set user = item.user %}
                        <div class="col">
                            <a href="{{ path('user_show', {'slug': user.slug}) }}" class="text-decoration-none">
                                <div class="card border overflow-hidden card-hover h-100">
                                    <div style="height: 7rem; background: linear-gradient(135deg, #FF5A5F, #E0484D);"></div>
                                    <div class="px-4 pb-4" style="margin-top: -3rem;">
                                        <img src="{{ user.avatar }}" alt="{{ user.fullName }}"
                                             class="rounded-circle border border-4 border-white object-fit-cover"
                                             style="width: 5rem; height: 5rem;">
                                        <h6 class="mt-3 fw-semibold text-dark mb-1">{{ user.fullName }}</h6>
                                        <p class="text-muted small mb-0 line-clamp-2">{{ user.bio ?? 'Experienced host' }}</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}