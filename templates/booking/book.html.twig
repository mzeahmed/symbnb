{% extends 'base.html.twig' %}

{% block title %}Book: {{ ad.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('booking') }}
{% endblock %}

{% block body %}
    {% set disabledDates = [] %}
    {% for day in ad.notAvailableDays %}
        {% set disabledDates = disabledDates|merge([day.format('Y-m-d')]) %}
    {% endfor %}

    <div
        id="booking-page"
        class="container py-5"
        style="max-width: 720px;"
        data-disabled-dates="{{ disabledDates|json_encode|e('html_attr') }}"
        data-price="{{ ad.price }}"
    >
        <h1 class="fw-bold text-dark mb-1">Book: <em class="fw-normal">{{ ad.title }}</em></h1>
        <p class="text-muted mb-5">
            You are about to book a property from <strong>{{ ad.author.fullName }}</strong> — tell us everything!
        </p>

        {{ form_start(form) }}

        <div class="card border shadow-soft mb-4">
            <div class="card-body p-4">
                <h5 class="fw-semibold text-dark mb-4">Which dates interest you?</h5>
                <div class="row g-4 mb-4">
                    <div class="col-12 col-sm-6">{{ form_row(form.startDate) }}</div>
                    <div class="col-12 col-sm-6">{{ form_row(form.endDate) }}</div>
                </div>
                <p class="text-dark fw-medium mb-4">
                    Total amount: <span id="amount" class="text-coral fw-bold">...</span> &euro;
                    <span class="text-muted small ms-2">(<span id="days">0</span> night(s) at {{ ad.price|number_format(2, ',', ' ') }} &euro; / night)</span>
                </p>

                <h5 class="fw-semibold text-dark mb-2">Do you have a comment?</h5>
                {{ form_row(form.comment) }}
            </div>
        </div>

        <div class="mb-5">
            <h2 class="fs-4 fw-bold text-dark mb-1">You're all set!</h2>
            <p class="text-muted">Dream vacation or business trip — we've got you covered!</p>
        </div>

        <button type="submit" class="btn btn-success btn-lg fw-semibold px-5">
            Book now
        </button>

        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('booking') }}
{% endblock %}